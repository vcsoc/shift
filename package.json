{
  "name": "the-shift",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch apps/api/src/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx apps/api/src/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "tsx apps/api/src/seed.ts",
    "format:check": "prettier --check 'apps/**/*.{ts,tsx,css,html}' 'packages/**/*.ts' 'tests/**/*.{ts,tsx}' '*.ts' '*.json' 'database/seeds/*.json'"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^12.4.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "fastify": "^5.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.4"
  }
}
